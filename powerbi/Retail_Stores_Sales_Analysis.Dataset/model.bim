{
  "name": "Retail_Stores_Sales_Analysis",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-US",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "tables": [
      {
        "name": "sales",
        "columns": [
          {
            "name": "order_id",
            "dataType": "string",
            "sourceColumn": "order_id"
          },
          {
            "name": "order_date",
            "dataType": "dateTime",
            "sourceColumn": "order_date",
            "formatString": "yyyy-mm-dd"
          },
          {
            "name": "product_id",
            "dataType": "string",
            "sourceColumn": "product_id"
          },
          {
            "name": "store_id",
            "dataType": "string",
            "sourceColumn": "store_id"
          },
          {
            "name": "customer_id",
            "dataType": "string",
            "sourceColumn": "customer_id"
          },
          {
            "name": "quantity",
            "dataType": "int64",
            "sourceColumn": "quantity"
          },
          {
            "name": "unit_price",
            "dataType": "double",
            "sourceColumn": "unit_price",
            "formatString": "\\$#,##0.00"
          },
          {
            "name": "discount",
            "dataType": "double",
            "sourceColumn": "discount",
            "formatString": "0.0%"
          },
          {
            "name": "revenue",
            "dataType": "double",
            "sourceColumn": "revenue",
            "formatString": "\\$#,##0.00"
          },
          {
            "name": "cost",
            "dataType": "double",
            "sourceColumn": "cost",
            "formatString": "\\$#,##0.00"
          },
          {
            "name": "profit",
            "dataType": "double",
            "sourceColumn": "profit",
            "formatString": "\\$#,##0.00"
          }
        ],
        "partitions": [
          {
            "name": "sales-Partition",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = try Csv.Document(File.Contents(\"data/raw/sales.csv\"),[Delimiter=\",\", Columns=11, Encoding=65001, QuoteStyle=QuoteStyle.None])",
                "             otherwise try Csv.Document(File.Contents(\"../../data/raw/sales.csv\"),[Delimiter=\",\", Columns=11, Encoding=65001, QuoteStyle=QuoteStyle.None])",
                "             otherwise Csv.Document(File.Contents(\"D:/Study/DA_Projects/Data/sales.csv\"),[Delimiter=\",\", Columns=11, Encoding=65001, QuoteStyle=QuoteStyle.None]),",
                "    #\"Promoted Headers\" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Promoted Headers\",{{\"order_id\", type text}, {\"order_date\", type date}, {\"product_id\", type text}, {\"store_id\", type text}, {\"customer_id\", type text}, {\"quantity\", Int64.Type}, {\"unit_price\", type number}, {\"discount\", type number}, {\"revenue\", type number}, {\"cost\", type number}, {\"profit\", type number}})",
                "in",
                "    #\"Changed Type\""
              ]
            }
          }
        ]
      },
      {
        "name": "products",
        "columns": [
          {
            "name": "product_id",
            "dataType": "string",
            "sourceColumn": "product_id"
          },
          {
            "name": "product_name",
            "dataType": "string",
            "sourceColumn": "product_name"
          },
          {
            "name": "brand",
            "dataType": "string",
            "sourceColumn": "brand"
          },
          {
            "name": "category",
            "dataType": "string",
            "sourceColumn": "category"
          },
          {
            "name": "cocoa_percent",
            "dataType": "int64",
            "sourceColumn": "cocoa_percent"
          },
          {
            "name": "weight_g",
            "dataType": "int64",
            "sourceColumn": "weight_g"
          }
        ],
        "partitions": [
          {
            "name": "products-Partition",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = try Csv.Document(File.Contents(\"data/raw/products.csv\"),[Delimiter=\",\", Columns=6, Encoding=65001, QuoteStyle=QuoteStyle.None])",
                "             otherwise try Csv.Document(File.Contents(\"../../data/raw/products.csv\"),[Delimiter=\",\", Columns=6, Encoding=65001, QuoteStyle=QuoteStyle.None])",
                "             otherwise Csv.Document(File.Contents(\"D:/Study/DA_Projects/Data/products.csv\"),[Delimiter=\",\", Columns=6, Encoding=65001, QuoteStyle=QuoteStyle.None]),",
                "    #\"Promoted Headers\" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Promoted Headers\",{{\"product_id\", type text}, {\"product_name\", type text}, {\"brand\", type text}, {\"category\", type text}, {\"cocoa_percent\", Int64.Type}, {\"weight_g\", Int64.Type}})",
                "in",
                "    #\"Changed Type\""
              ]
            }
          }
        ]
      },
      {
        "name": "customers",
        "columns": [
          {
            "name": "customer_id",
            "dataType": "string",
            "sourceColumn": "customer_id"
          },
          {
            "name": "age",
            "dataType": "int64",
            "sourceColumn": "age"
          },
          {
            "name": "gender",
            "dataType": "string",
            "sourceColumn": "gender"
          },
          {
            "name": "loyalty_member",
            "dataType": "int64",
            "sourceColumn": "loyalty_member"
          },
          {
            "name": "join_date",
            "dataType": "dateTime",
            "sourceColumn": "join_date",
            "formatString": "yyyy-mm-dd"
          },
          {
            "name": "age_group",
            "dataType": "string",
            "sourceColumn": "age_group"
          }
        ],
        "partitions": [
          {
            "name": "customers-Partition",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = try Csv.Document(File.Contents(\"data/raw/customers.csv\"),[Delimiter=\",\", Columns=5, Encoding=65001, QuoteStyle=QuoteStyle.None])",
                "             otherwise try Csv.Document(File.Contents(\"../../data/raw/customers.csv\"),[Delimiter=\",\", Columns=5, Encoding=65001, QuoteStyle=QuoteStyle.None])",
                "             otherwise Csv.Document(File.Contents(\"D:/Study/DA_Projects/Data/customers.csv\"),[Delimiter=\",\", Columns=5, Encoding=65001, QuoteStyle=QuoteStyle.None]),",
                "    #\"Promoted Headers\" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Promoted Headers\",{{\"customer_id\", type text}, {\"age\", Int64.Type}, {\"gender\", type text}, {\"loyalty_member\", Int64.Type}, {\"join_date\", type date}}),",
                "    #\"Added Age Group\" = Table.AddColumn(#\"Changed Type\", \"age_group\", each if [age] <= 25 then \"18-25\" else if [age] <= 35 then \"26-35\" else if [age] <= 45 then \"36-45\" else if [age] <= 55 then \"46-55\" else \"56-70\", type text)",
                "in",
                "    #\"Added Age Group\""
              ]
            }
          }
        ]
      },
      {
        "name": "stores",
        "columns": [
          {
            "name": "store_id",
            "dataType": "string",
            "sourceColumn": "store_id"
          },
          {
            "name": "store_name",
            "dataType": "string",
            "sourceColumn": "store_name"
          },
          {
            "name": "city",
            "dataType": "string",
            "sourceColumn": "city"
          },
          {
            "name": "country",
            "dataType": "string",
            "sourceColumn": "country"
          },
          {
            "name": "store_type",
            "dataType": "string",
            "sourceColumn": "store_type"
          }
        ],
        "partitions": [
          {
            "name": "stores-Partition",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = try Csv.Document(File.Contents(\"data/raw/stores.csv\"),[Delimiter=\",\", Columns=5, Encoding=65001, QuoteStyle=QuoteStyle.None])",
                "             otherwise try Csv.Document(File.Contents(\"../../data/raw/stores.csv\"),[Delimiter=\",\", Columns=5, Encoding=65001, QuoteStyle=QuoteStyle.None])",
                "             otherwise Csv.Document(File.Contents(\"D:/Study/DA_Projects/Data/stores.csv\"),[Delimiter=\",\", Columns=5, Encoding=65001, QuoteStyle=QuoteStyle.None]),",
                "    #\"Promoted Headers\" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Promoted Headers\",{{\"store_id\", type text}, {\"store_name\", type text}, {\"city\", type text}, {\"country\", type text}, {\"store_type\", type text}})",
                "in",
                "    #\"Changed Type\""
              ]
            }
          }
        ]
      },
      {
        "name": "calendar",
        "columns": [
          {
            "name": "date",
            "dataType": "dateTime",
            "sourceColumn": "date",
            "formatString": "yyyy-mm-dd"
          },
          {
            "name": "year",
            "dataType": "int64",
            "sourceColumn": "year"
          },
          {
            "name": "month",
            "dataType": "int64",
            "sourceColumn": "month"
          },
          {
            "name": "day",
            "dataType": "int64",
            "sourceColumn": "day"
          },
          {
            "name": "week",
            "dataType": "int64",
            "sourceColumn": "week"
          },
          {
            "name": "day_of_week",
            "dataType": "int64",
            "sourceColumn": "day_of_week"
          },
          {
            "name": "day_name",
            "dataType": "string",
            "sourceColumn": "day_name"
          },
          {
            "name": "is_weekend",
            "dataType": "string",
            "sourceColumn": "is_weekend"
          }
        ],
        "partitions": [
          {
            "name": "calendar-Partition",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = try Csv.Document(File.Contents(\"data/raw/calendar.csv\"),[Delimiter=\",\", Columns=6, Encoding=65001, QuoteStyle=QuoteStyle.None])",
                "             otherwise try Csv.Document(File.Contents(\"../../data/raw/calendar.csv\"),[Delimiter=\",\", Columns=6, Encoding=65001, QuoteStyle=QuoteStyle.None])",
                "             otherwise Csv.Document(File.Contents(\"D:/Study/DA_Projects/Data/calendar.csv\"),[Delimiter=\",\", Columns=6, Encoding=65001, QuoteStyle=QuoteStyle.None]),",
                "    #\"Promoted Headers\" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Promoted Headers\",{{\"date\", type date}, {\"year\", Int64.Type}, {\"month\", Int64.Type}, {\"day\", Int64.Type}, {\"week\", Int64.Type}, {\"day_of_week\", Int64.Type}}),",
                "    #\"Added Day Name\" = Table.AddColumn(#\"Changed Type\", \"day_name\", each if [day_of_week] = 0 then \"Monday\" else if [day_of_week] = 1 then \"Tuesday\" else if [day_of_week] = 2 then \"Wednesday\" else if [day_of_week] = 3 then \"Thursday\" else if [day_of_week] = 4 then \"Friday\" else if [day_of_week] = 5 then \"Saturday\" else \"Sunday\", type text),",
                "    #\"Added Is Weekend\" = Table.AddColumn(#\"Added Day Name\", \"is_weekend\", each if [day_of_week] >= 5 then \"Weekend\" else \"Weekday\", type text)",
                "in",
                "    #\"Added Is Weekend\""
              ]
            }
          }
        ]
      },
      {
        "name": "_Measures",
        "columns": [
          {
            "name": "Measure_ID",
            "dataType": "int64",
            "sourceColumn": "Measure_ID",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "_Measures-Partition",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"i45WMlSKjQUA\", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Measure_ID = _t]),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(Source,{{\"Measure_ID\", Int64.Type}})",
                "in",
                "    #\"Changed Type\""
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Revenue",
            "expression": "SUM(sales[revenue])",
            "formatString": "\\$#,##0.00",
            "description": "Sum of transaction revenue after discount ($25,486,128.86)"
          },
          {
            "name": "Total Cost",
            "expression": "SUM(sales[cost])",
            "formatString": "\\$#,##0.00",
            "description": "Total Cost of Goods Sold ($15,291,554.40)"
          },
          {
            "name": "Total Profit",
            "expression": "SUM(sales[profit])",
            "formatString": "\\$#,##0.00",
            "description": "Net Operating Profit ($10,194,564.63)"
          },
          {
            "name": "Total Quantity",
            "expression": "SUM(sales[quantity])",
            "formatString": "#,##0",
            "description": "Total units sold (2,999,589 units)"
          },
          {
            "name": "Total Orders",
            "expression": "DISTINCTCOUNT(sales[order_id])",
            "formatString": "#,##0",
            "description": "Total order transactions (1,000,000 orders)"
          },
          {
            "name": "Profit Margin %",
            "expression": "DIVIDE([Total Profit], [Total Revenue], 0)",
            "formatString": "0.00%",
            "description": "Operating Profit Margin (40.00%)"
          },
          {
            "name": "Average Order Value",
            "expression": "DIVIDE([Total Revenue], [Total Orders], 0)",
            "formatString": "\\$#,##0.00",
            "description": "Average basket value per order ($25.49)"
          },
          {
            "name": "Average Selling Price",
            "expression": "DIVIDE([Total Revenue], [Total Quantity], 0)",
            "formatString": "\\$#,##0.00",
            "description": "Net realized price per unit ($8.50)"
          },
          {
            "name": "Average Discount %",
            "expression": "AVERAGE(sales[discount])",
            "formatString": "0.00%",
            "description": "Mean discount rate applied (5.62%)"
          },
          {
            "name": "2023 Revenue",
            "expression": "CALCULATE([Total Revenue], calendar[year] = 2023)",
            "formatString": "\\$#,##0.00",
            "description": "Total revenue in 2023 ($12,735,106.27)"
          },
          {
            "name": "2024 Revenue",
            "expression": "CALCULATE([Total Revenue], calendar[year] = 2024)",
            "formatString": "\\$#,##0.00",
            "description": "Total revenue in 2024 ($12,751,022.59)"
          },
          {
            "name": "YoY Revenue Growth $",
            "expression": "[2024 Revenue] - [2023 Revenue]",
            "formatString": "+\\$#,##0.00;-\\$#,##0.00;\\$0.00",
            "description": "YoY revenue growth in dollars (+$15,916.32)"
          },
          {
            "name": "YoY Revenue Growth %",
            "expression": "DIVIDE([YoY Revenue Growth $], [2023 Revenue], 0)",
            "formatString": "+0.00%;-0.00%;0.00%",
            "description": "YoY percentage growth (+0.12%)"
          },
          {
            "name": "2023 Profit",
            "expression": "CALCULATE([Total Profit], calendar[year] = 2023)",
            "formatString": "\\$#,##0.00",
            "description": "Total profit in 2023 ($5,093,596.88)"
          },
          {
            "name": "2024 Profit",
            "expression": "CALCULATE([Total Profit], calendar[year] = 2024)",
            "formatString": "\\$#,##0.00",
            "description": "Total profit in 2024 ($5,100,967.75)"
          },
          {
            "name": "Revenue per Store",
            "expression": "DIVIDE([Total Revenue], DISTINCTCOUNT(stores[store_id]), 0)",
            "formatString": "\\$#,##0.00",
            "description": "Average revenue generated per store facility ($254,861.29)"
          },
          {
            "name": "Profit per Store",
            "expression": "DIVIDE([Total Profit], DISTINCTCOUNT(stores[store_id]), 0)",
            "formatString": "\\$#,##0.00",
            "description": "Average profit generated per store facility ($101,945.65)"
          },
          {
            "name": "Revenue per Customer",
            "expression": "DIVIDE([Total Revenue], DISTINCTCOUNT(customers[customer_id]), 0)",
            "formatString": "\\$#,##0.00",
            "description": "Average 2-year spend per registered customer ($509.72)"
          },
          {
            "name": "Orders per Customer",
            "expression": "DIVIDE([Total Orders], DISTINCTCOUNT(customers[customer_id]), 0)",
            "formatString": "#,##0.00",
            "description": "Average purchase frequency per customer (20.00 orders)"
          },
          {
            "name": "Average Daily Revenue",
            "expression": "DIVIDE([Total Revenue], DISTINCTCOUNT(sales[order_date]), 0)",
            "formatString": "\\$#,##0.00",
            "description": "Mean revenue per calendar day across 731 days ($34,864.75)"
          },
          {
            "name": "Average Daily Orders",
            "expression": "DIVIDE([Total Orders], DISTINCTCOUNT(sales[order_date]), 0)",
            "formatString": "#,##0.0",
            "description": "Mean order count per calendar day (1,368.0 orders/day)"
          },
          {
            "name": "Orphan Product Revenue",
            "expression": "CALCULATE([Total Revenue], sales[product_id] IN { \"P0000\", \"P0201\" })",
            "formatString": "\\$#,##0.00",
            "description": "Revenue from orphan keys P0000 and P0201 ($247,480.64)"
          },
          {
            "name": "Catalog Product Revenue",
            "expression": "CALCULATE([Total Revenue], NOT(sales[product_id] IN { \"P0000\", \"P0201\" }))",
            "formatString": "\\$#,##0.00",
            "description": "Revenue from valid catalog products P0001-P0200 ($25,238,648.22)"
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "sales_product_FK",
        "fromTable": "sales",
        "fromColumn": "product_id",
        "toTable": "products",
        "toColumn": "product_id"
      },
      {
        "name": "sales_customer_FK",
        "fromTable": "sales",
        "fromColumn": "customer_id",
        "toTable": "customers",
        "toColumn": "customer_id"
      },
      {
        "name": "sales_store_FK",
        "fromTable": "sales",
        "fromColumn": "store_id",
        "toTable": "stores",
        "toColumn": "store_id"
      },
      {
        "name": "sales_calendar_FK",
        "fromTable": "sales",
        "fromColumn": "order_date",
        "toTable": "calendar",
        "toColumn": "date"
      }
    ]
  }
}